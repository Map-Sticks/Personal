<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Space Plans Stage 3.6" Height="960" Width="1200" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="individual" Content="Individual Spaces" GroupName="mode" IsChecked="True"/><RadioButton x:Name="grouped" Content="One Group" GroupName="mode" Margin="16,0"/><TextBlock Text="Group Name" VerticalAlignment="Center"/><TextBox x:Name="group_name" Width="300" Margin="8,0"/></StackPanel><Border Grid.Row="1" BorderBrush="#BFBFBF" BorderThickness="1" Padding="8" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><TextBlock Text="Generate:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/><CheckBox x:Name="make_floor" Content="Floor Plan" Margin="0,0,18,0" Checked="options_changed" Unchecked="options_changed"/><CheckBox x:Name="make_rcp" Content="RCP" Margin="0,0,18,0" Checked="options_changed" Unchecked="options_changed"/><CheckBox x:Name="make_elev" Content="Wall Elevations" Margin="0,0,28,0" Checked="options_changed" Unchecked="options_changed"/><CheckBox x:Name="make_sheets" Content="Create sheet and place selected views" FontWeight="Bold" Checked="options_changed" Unchecked="options_changed"/></StackPanel></Border><DockPanel Grid.Row="2" Margin="0,0,0,8"><Button Content="Clear" DockPanel.Dock="Right" Width="65" Click="clear"/><TextBox x:Name="searchbox" TextChanged="search" ToolTip="Search Level, Number or Name"/></DockPanel><DataGrid x:Name="grid" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}" Width="55"/><DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="170"/><DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="140"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="4" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><Button Content="Select All Visible" Click="allon"/><Button Content="Select None Visible" Click="alloff" Margin="0,5"/><GroupBox x:Name="floor_panel" Header="Floor Plan"><StackPanel Margin="6"><TextBlock Text="Plan/RCP Scale"/><TextBox x:Name="scale"/><TextBlock Text="Crop Buffer mm"/><TextBox x:Name="buffer"/><TextBlock Text="Floor Template"/><ComboBox x:Name="floor_template"/><TextBlock Text="Plan Viewport Type"/><ComboBox x:Name="plan_vptype"/></StackPanel></GroupBox><GroupBox x:Name="rcp_panel" Header="RCP" Margin="0,8,0,0"><StackPanel Margin="6"><TextBlock Text="RCP Template"/><ComboBox x:Name="rcp_template"/><TextBlock Text="RCP Viewport Type"/><ComboBox x:Name="rcp_vptype"/></StackPanel></GroupBox></StackPanel><GroupBox x:Name="elevation_panel" Grid.Column="1" Header="Wall Elevations" Margin="0,0,10,0"><StackPanel Margin="8"><TextBlock Text="Elevation Type"/><ComboBox x:Name="elevtype"/><TextBlock Text="Elevation Template"/><ComboBox x:Name="elev_template"/><TextBlock Text="Elevation Scale"/><TextBox x:Name="escale"/><TextBlock Text="Elevation Viewport Type"/><ComboBox x:Name="elev_vptype"/><TextBlock Text="Minimum Height mm"/><TextBox x:Name="minheight"/><TextBlock Text="Side / Bottom / Top Offset mm"/><StackPanel Orientation="Horizontal"><TextBox x:Name="side" Width="65"/><TextBox x:Name="bottom" Width="65" Margin="4,0"/><TextBox x:Name="top" Width="65"/></StackPanel><TextBlock Text="View Depth mm"/><TextBox x:Name="depth"/><TextBlock Text="Merge Gap mm"/><TextBox x:Name="merge"/><TextBlock Text="Duplicate Tolerance mm"/><TextBox x:Name="duplicate"/><TextBlock Text="Angle Tolerance degrees"/><TextBox x:Name="angtol"/><TextBlock Text="Minimum Wall mm"/><TextBox x:Name="minwall"/></StackPanel></GroupBox><GroupBox x:Name="sheet_panel" Grid.Column="2" Header="Sheet Output" Margin="0,0,10,0"><StackPanel Margin="8"><TextBlock Text="Sheet Mode"/><ComboBox x:Name="sheetmode"/><TextBlock Text="Title Block"/><ComboBox x:Name="titleblock"/><TextBlock Text="Sheet Prefix / Start"/><StackPanel Orientation="Horizontal"><TextBox x:Name="prefix" Width="90"/><TextBox x:Name="start" Width="90" Margin="5,0,0,0"/></StackPanel><TextBlock Text="Review Width / Height mm"/><StackPanel Orientation="Horizontal"><TextBox x:Name="width" Width="90"/><TextBox x:Name="height" Width="90" Margin="5,0,0,0"/></StackPanel><TextBlock Text="If sheet output is unticked, selected views are created in the Project Browser only." TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,0"/></StackPanel></GroupBox><GroupBox Grid.Column="3" Header="Usable Sheet Area"><StackPanel Margin="8"><TextBlock Text="Left / Right Margin mm"/><StackPanel Orientation="Horizontal"><TextBox x:Name="left_margin" Width="90"/><TextBox x:Name="right_margin" Width="90" Margin="5,0,0,0"/></StackPanel><TextBlock Text="Top / Bottom Margin mm"/><StackPanel Orientation="Horizontal"><TextBox x:Name="top_margin" Width="90"/><TextBox x:Name="bottom_margin" Width="90" Margin="5,0,0,0"/></StackPanel><TextBlock Text="Reserved Right Titleblock mm"/><TextBox x:Name="reserved_right"/><TextBlock Text="Horizontal / Vertical Gap mm"/><StackPanel Orientation="Horizontal"><TextBox x:Name="hgap" Width="90"/><TextBox x:Name="vgap" Width="90" Margin="5,0,0,0"/></StackPanel><TextBlock Text="Examples: RCP only; Floor Plan only; Elevations only; any combination, with or without sheets." TextWrapping="Wrap" Foreground="Gray" Margin="0,10,0,0"/></StackPanel></GroupBox></Grid><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" Click="cancel"/><Button Content="Generate" Width="130" Margin="8,0,0,0" IsDefault="True" Click="go"/></StackPanel></Grid></Window>
