<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Align Existing Elevation Rows" Width="500" Height="360" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Align every elevation row already on this sheet" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Grid.Row="1" Text="Vertical alignment"/><ComboBox x:Name="mode" Grid.Row="2" Margin="0,3,0,10"/><Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Row detection tolerance (mm)"/><TextBox x:Name="tolerance"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Horizontal gap (mm)"/><TextBox x:Name="gap"/></StackPanel></Grid><TextBlock Grid.Row="4" Text="This tool keeps the current upper and lower row membership. It groups rows using each viewport box bottom, then aligns every detected row independently. It does not rebuild the sheet layout or move views between rows." TextWrapping="Wrap" Foreground="Gray" Margin="0,14,0,0"/><StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" Click="cancel"/><Button Content="Align Rows" Width="110" Margin="8,0,0,0" IsDefault="True" Click="apply"/></StackPanel></Grid></Window>
