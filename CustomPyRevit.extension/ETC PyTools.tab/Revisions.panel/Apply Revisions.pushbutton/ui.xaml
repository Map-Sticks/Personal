<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Custom Revisions" Height="600" Width="950" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    <RowDefinition Height="Auto"/> </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,15">
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Selected Sheets:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock x:Name="txt_selected_count" Text="0" VerticalAlignment="Center" Margin="5,0,20,0"/>
                
                <Button x:Name="btn_select_all" Content="Check All" Width="80" Height="25" Click="select_all_click"/>
                <Button x:Name="btn_select_none" Content="Uncheck All" Width="80" Height="25" Margin="5,0,20,0" Click="select_none_click"/>
                
                <TextBlock Text="Arrangement:" VerticalAlignment="Center" FontWeight="Bold" Margin="30,0,5,0"/>
                <ComboBox x:Name="combo_direction" Width="95" Height="25" SelectedIndex="0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Top-Down"/>
                    <ComboBoxItem Content="Bottom-Up"/>
                </ComboBox>

                <TextBlock Text="Max Rows:" VerticalAlignment="Center" FontWeight="Bold" Margin="15,0,5,0"/>
                <TextBox x:Name="box_max_rows" Width="35" Height="25" VerticalContentAlignment="Center" ToolTip="Leave blank to use all physical rows available."/>
            </StackPanel>

            <Border Background="#F8F8F8" Padding="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Bulk Edit Checked/Highlighted Rows:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0"/>
                    
                    <TextBlock Text="Prefix:" VerticalAlignment="Center"/>
                    <TextBox x:Name="box_bulk_prefix" Width="60" Margin="5,0,5,0" VerticalContentAlignment="Center"/>
                    <Button x:Name="btn_apply_bulk_prefix" Content="Apply Prefix" Width="80" Height="25" Click="bulk_apply_prefix_click"/>

                    <TextBlock Text="Number:" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBox x:Name="box_bulk_number" Width="60" Margin="5,0,5,0" VerticalContentAlignment="Center" PreviewTextInput="alphanumeric_filter"/>
                    <Button x:Name="btn_apply_bulk_number" Content="Apply Number" Width="90" Height="25" Click="bulk_apply_number_click"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid x:Name="data_grid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Extended" AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column"
                  SelectionChanged="grid_selection_changed" CellEditEnding="grid_cell_edited">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="40" Header="Check">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Sheet Number" Binding="{Binding SheetNumber}" IsReadOnly="True" Width="100"/>
                <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}" IsReadOnly="True" Width="200"/>
                <DataGridTextColumn Header="Last Rev" Binding="{Binding LastRevision}" IsReadOnly="True" Width="70"/>
                
                <DataGridTextColumn Header="Prefix" Binding="{Binding CurrentPrefix, UpdateSourceTrigger=PropertyChanged}" Width="70">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="#E8F4F8"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Next Number" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding NextNumber, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsNumberEditable}"
                                     PreviewTextInput="alphanumeric_filter" 
                                     KeyUp="number_input_keyup"
                                     LostFocus="number_input_lostfocus"
                                     BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Preview" Binding="{Binding PredictedFullRevision}" IsReadOnly="True" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock x:Name="txt_error" Grid.Column="0" Foreground="Red" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button x:Name="btn_cancel" Grid.Column="1" Content="Cancel" Width="100" Height="30" Margin="0,0,10,0" Click="cancel_click"/>
            <Button x:Name="btn_apply" Grid.Column="2" Content="Apply Changes" Width="120" Height="30" FontWeight="Bold" Background="#0078D7" Foreground="White" Click="apply_click"/>
        </Grid>
    </Grid>
</Window>