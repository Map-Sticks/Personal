<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Manual Fixture Placement" Height="720" Width="1320" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="False">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><Button Name="btnReloadSpaces" Content="Reload Spaces" Width="120" Margin="0,0,8,0"/><Button Name="btnClose" Content="Close" Width="80"/><TextBlock Name="txtStatus" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#444" Text="Ready."/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="Spaces (select one)"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><CheckBox Name="cbActiveView" Grid.Row="0" Margin="0,0,0,8" Content="Show Active View Spaces Only" IsChecked="True"/><TextBox Name="tbSpaceSearch" Grid.Row="1" Margin="0,0,0,6" ToolTip="Filter spaces by number/name"/><ListBox Name="lbSpaces" Grid.Row="2" SelectionMode="Single"/></Grid></GroupBox>
      <Grid Grid.Column="2" Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><Button Name="btnPickWalls" Content="Pick Walls (for selected Space)" Width="240" Margin="0,0,8,0"/><Button Name="btnClearWalls" Content="Clear Walls (selected Space)" Width="210" Margin="0,0,8,0"/><Separator Width="10"/><Button Name="btnAddTypes" Content="Add Selected Types to Checked Walls" Width="240" Margin="8,0,8,0"/><Button Name="btnPlace" Content="Place Fixtures" Width="120" Margin="0,0,8,0"/><Button Name="btnUndoPlace" Content="Undo Last Place" Width="120" Margin="0,0,8,0" IsEnabled="False"/></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions>
          <GroupBox Grid.Column="0" Header="Selected Space: Walls / Individual Fixture Controls"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" ClipToBounds="True"><Canvas Name="canvasWallMap" ClipToBounds="True" SnapsToDevicePixels="True"/></Border><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#EEEEEE"/><TreeView Grid.Row="2" Name="tvConfig"/></Grid></GroupBox>
          <GroupBox Grid.Column="1" Header="Default Settings for Next Added Type"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Elevation (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Name="tbElevation" Text="300" Margin="4"/><TextBlock Grid.Row="1" Grid.Column="0" Text="Offset from Host (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Name="tbHostOffset" Text="0" Margin="4"/><TextBlock Grid.Row="2" Grid.Column="0" Text="End Offset (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Name="tbEndOffset" Text="300" Margin="4"/><TextBlock Grid.Row="3" Grid.Column="0" Text="Min Spacing (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Name="tbMinSpacing" Text="250" Margin="4"/><TextBlock Grid.Row="4" Grid.Column="0" Text="Comments Base:" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Name="tbComments" Text="OUTLET" Margin="4"/><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4"><TextBlock Text="Default Qty for Add:" VerticalAlignment="Center"/><TextBox Name="tbDefaultQty" Text="1" Width="60" Margin="8,0,0,0"/></StackPanel><GroupBox Grid.Row="7" Grid.ColumnSpan="2" Header="Available Families (Check to Add)"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4"><StackPanel Name="spFamilies"/></ScrollViewer></GroupBox></Grid></GroupBox>
        </Grid>
      </Grid>
    </Grid>
    <TextBlock Grid.Row="2" Foreground="#666" Margin="2,8,2,0" TextWrapping="Wrap" Text="Manual Placement: Select Space → Pick Walls → Adjust Defaults → Check Families/Types → Add → Place Fixtures."/>
  </Grid>
</Window>