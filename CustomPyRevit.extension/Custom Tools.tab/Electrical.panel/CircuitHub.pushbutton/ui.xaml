<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Circuit Hub" Height="980" Width="1480"
        MinHeight="820" MinWidth="1200"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="False">
  <Window.Resources>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFB8D6FB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF000000"/>
  </Window.Resources>
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
      <Button Name="btnRefresh" Content="Refresh" Width="80" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnUndoLast" Content="Undo last" Width="85" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnLocateRevitSelection" Content="Locate selection" Width="120" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnShowAllPanels" Content="Open all" Width="80" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnShowTargetOnly" Content="Target only" Width="85" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnExpandSelected" Content="Expand" Width="75" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <Button Name="btnCollapseSelected" Content="Collapse" Width="80" Margin="0,0,12,0" DockPanel.Dock="Left"/>
      <Button Name="btnClose" Content="Close" Width="70" Margin="8,0,0,0" DockPanel.Dock="Right"/>
      <TextBlock Text="Level:" VerticalAlignment="Center" Margin="8,0,6,0" DockPanel.Dock="Left"/>
      <ComboBox Name="cmbLevelFilter" Width="170" Margin="0,0,8,0" DockPanel.Dock="Left"/>
      <CheckBox Name="chkShowEmptyPanels" Content="Show empty panels" VerticalAlignment="Center" Margin="0,0,8,0" DockPanel.Dock="Left"/>
      <CheckBox Name="chkAutoRefresh" Content="Auto refresh" VerticalAlignment="Center" Margin="0,0,12,0" DockPanel.Dock="Left"/>
      <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" DockPanel.Dock="Left"/>
      <TextBox Name="tbSearch" VerticalContentAlignment="Center"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="560"/><ColumnDefinition Width="8"/><ColumnDefinition Width="520" MinWidth="500"/></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="Panels / Circuits / Fixtures - yellow groups = powered circuits with no panel, grouped by fixture level; Auto refresh can be off for large models">
        <ListBox Name="lbItems" Margin="6" SelectionMode="Extended" AllowDrop="True"/>
      </GroupBox>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#DDD"/>
      <TabControl Grid.Column="2" Margin="8,0,0,0">
        <TabItem Header="Actions"><StackPanel Margin="8">
          <TextBlock Text="Target circuit" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Name="txtPanel" Text="Target panel: -" TextWrapping="Wrap" Margin="0,0,0,2"/>
          <TextBlock Name="txtCircuit" Text="Target circuit: -" TextWrapping="Wrap" Margin="0,0,0,2"/>
          <TextBlock Name="txtLoad" Text="Target load: -" TextWrapping="Wrap" Margin="0,0,0,8"/>
          <UniformGrid Columns="2" Margin="0,0,0,8">
            <Button Name="btnSelectRowsInView" Content="Rows: Select in Revit" Height="30" Margin="2"/>
            <Button Name="btnMoveSelectedCircuits" Content="Rows: Move circuits" Height="30" Margin="2"/>
            <Button Name="btnRemoveSelectedFixtureRows" Content="Rows: Remove fixtures" Height="30" Margin="2"/>
            <Button Name="btnRenameLoad" Content="Target: Rename load" Height="30" Margin="2"/>
            <Button Name="btnMoveTargetPanel" Content="Target: Move via list" Height="30" Margin="2"/>
            <Button Name="btnCreateSchedule" Content="Create panel schedule" Height="30" Margin="2"/>
          </UniformGrid>
          <TextBlock Text="Revit selection actions" FontWeight="Bold" Margin="0,8,0,4"/>
          <UniformGrid Columns="1">
            <Button Name="btnAddRevitSelection" Content="Add selected to target circuit (uncircuited only)" Height="32" Margin="2"/>
            <Button Name="btnReassignRevitSelection" Content="Reassign selected to target circuit" Height="32" Margin="2"/>
            <Button Name="btnMoveCircuitsToPanel" Content="Move selected fixture circuits to panel..." Height="32" Margin="2"/>
            <Button Name="btnPickPanelInView" Content="Move selected fixture circuits to picked panel in view..." Height="32" Margin="2"/>
            <Button Name="btnRemoveRevitSelection" Content="Remove selected from target circuit" Height="32" Margin="2"/>
            <Button Name="btnRemoveSelectionFromAllCircuits" Content="Quick: Remove selected from all circuits" Height="32" Margin="2"/>
            <Button Name="btnCreateCircuit" Content="Create new circuit from selected / panel" Height="32" Margin="2"/>
          </UniformGrid>
        </StackPanel></TabItem>
        <TabItem Header="Panels"><StackPanel Margin="8">
          <TextBlock Text="Rename panels" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="Highlight real PANEL rows in the tree. Enable Show empty panels to include panels without circuits. Unassigned groups are not panels." TextWrapping="Wrap" Margin="0,0,0,8"/>
          <Button Name="btnRenamePanel" Content="Rename one highlighted panel..." Height="32" Margin="0,0,0,12"/>
          <TextBlock Text="Bulk rename highlighted panels" FontWeight="Bold" Margin="0,0,0,6"/>
          <TextBlock Text="Find (literal, case-sensitive; blank skips replacement)"/>
          <TextBox Name="tbPanelFind" Margin="0,4,0,8"/>
          <TextBlock Text="Replace with (may be blank)"/>
          <TextBox Name="tbPanelReplace" Margin="0,4,0,8"/>
          <TextBlock Text="Prefix"/>
          <TextBox Name="tbPanelPrefix" Margin="0,4,0,8"/>
          <TextBlock Text="Suffix"/>
          <TextBox Name="tbPanelSuffix" Margin="0,4,0,8"/>
          <Button Name="btnBulkRenamePanels" Content="Preview bulk rename..." Height="32" Margin="0,4,0,8"/>
          <TextBlock Text="Replacement is applied first, then prefix and suffix. Expand confirmation details to review every change. Blank or duplicate names are blocked. Cancel makes no changes; confirmation uses one undoable transaction." TextWrapping="Wrap" Foreground="#555"/>
        </StackPanel></TabItem>
        <TabItem Header="Filter"><StackPanel Margin="8">
          <TextBlock Text="Category / fixture filter" FontWeight="Bold" Margin="0,0,0,6"/>
          <CheckBox Name="chkCategoryFilter" Content="Enable category filter before Revit-selection actions" Margin="0,0,0,6"/>
          <TextBlock Name="txtCategoryFilterSummary" Text="Category filter: -" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,6"/>
          <Button Name="btnCategoryFilter" Content="Category filter..." Height="30" Margin="0,0,0,6"/>
          <Button Name="btnApplyCategoryFilter" Content="Apply filter to current Revit selection" Height="30"/>
          <Separator Margin="0,12,0,12"/>
          <TextBlock Text="Workflow" FontWeight="Bold"/>
          <TextBlock Text="Select mixed items in Revit, apply filter or run an action. Disallowed categories are unselected and only allowed fixtures are processed." TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel></TabItem>
        <TabItem Header="Info"><StackPanel Margin="8">
          <TextBlock Text="Selection rules" FontWeight="Bold" Margin="0,0,0,4"/>
          <TextBlock Text="Highlighted rows in the list are separate from the Revit model selection." TextWrapping="Wrap"/>
          <TextBlock Text="Move selected fixture circuits to picked panel in view: select fixtures/outlets in the model, click the button, then pick the target panel in the view. It moves existing circuits only." TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="Inline + next to a circuit adds/reassigns currently selected Revit fixtures to that circuit." TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Text="Inline - next to a fixture removes that fixture from its circuit." TextWrapping="Wrap" Margin="0,4,0,0"/>
          <TextBlock Name="txtSelectedSummary" Text="Highlighted rows: 0 circuit row(s), 0 fixture row(s)." Foreground="#555" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel></TabItem>
      </TabControl>
    </Grid>
    <GroupBox Grid.Row="2" Header="Activity log" Margin="0,8,0,0"><ListBox Name="lbLog" FontFamily="Consolas" FontSize="11" Margin="6"/></GroupBox>
    <TextBlock Grid.Row="3" Name="txtStatus" Text="Ready." Foreground="#444" Margin="2,6,2,0" TextWrapping="Wrap"/>
  </Grid>
</Window>