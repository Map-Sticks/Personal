<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parameter Browser" Width="1400" Height="720" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbSource" Width="120" SelectionChanged="source_changed" Margin="0,0,14,0"/>
                <TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbScope" Width="140" SelectionChanged="scope_changed" Margin="0,0,14,0"/>
                <TextBlock x:Name="lblLevel" Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="cmbLevel" Width="180" SelectionChanged="level_changed" Margin="0,0,14,0"/>
                <Button Content="Columns..." Click="choose_columns" Padding="12,4" Margin="0,0,6,0"
                        ToolTip="Choose which parameters and 'Count:' columns are shown"/>
                <Button Content="Refresh Model" Click="refresh_clicked" Padding="12,4"
                        ToolTip="Re-read Spaces/Rooms and their elements from the active project and view"/>
            </WrapPanel>
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Clear" Click="clear_clicked" Padding="12,4" Margin="6,0,0,0"/>
                <TextBox x:Name="txtSearch" Height="30" VerticalContentAlignment="Center" FontSize="14"
                         TextChanged="search_changed"
                         ToolTip="Space-separated words; every word must appear in a visible column"/>
            </DockPanel>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Select in Revit" Click="select_clicked" Padding="14,5" Margin="0,0,6,0"
                        ToolTip="Select the highlighted rows in Revit"/>
                <Button Content="Show / Zoom" Click="show_clicked" Padding="14,5" Margin="0,0,6,0"
                        ToolTip="Select and show the highlighted rows in Revit"/>
                <Button Content="Close" Click="close_clicked" Padding="14,5"/>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="lblCount" FontWeight="SemiBold"/>
                <TextBlock x:Name="lblStatus" Foreground="#555555" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="380" MinWidth="220"/>
            </Grid.ColumnDefinitions>
            <DataGrid x:Name="grid" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True"
                      CanUserReorderColumns="True" CanUserResizeColumns="True"
                      MouseDoubleClick="row_double_clicked" SelectionChanged="grid_selection_changed"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Categories..." Click="choose_categories" Padding="10,3"
                                ToolTip="Choose which categories are listed in this panel"/>
                        <TextBlock Text="Elements in selection" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>
                    <CheckBox x:Name="chkUnassigned" Content="Show elements not in any Space/Room" Margin="0,6,0,0"
                              Checked="unassigned_toggled" Unchecked="unassigned_toggled"/>
                    <TextBlock x:Name="lblContents" TextWrapping="Wrap" Foreground="#555555" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button Content="Select in Revit" Click="contents_select_clicked" Padding="12,4" Margin="0,0,6,0"
                            ToolTip="Select the highlighted node's elements (or all listed if none is highlighted)"/>
                    <Button Content="Show / Zoom" Click="contents_show_clicked" Padding="12,4"
                            ToolTip="Select and show the highlighted node's elements (or all listed)"/>
                </StackPanel>
                <TreeView x:Name="treeContents"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
