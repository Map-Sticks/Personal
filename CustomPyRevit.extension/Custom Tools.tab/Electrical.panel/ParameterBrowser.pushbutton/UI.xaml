<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Parameter Browser" Width="1100" Height="680" MinWidth="760" MinHeight="440" WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
<DockPanel Margin="10">
 <StackPanel DockPanel.Dock="Top">
  <WrapPanel Margin="0,0,0,8">
   <TextBlock Text="Source" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="cmbSource" Width="120" SelectionChanged="source_changed" Margin="0,0,14,0"/>
   <TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="cmbScope" Width="140" SelectionChanged="scope_changed" Margin="0,0,14,0"/>
   <TextBlock x:Name="lblLevel" Text="Level" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="cmbLevel" Width="180" SelectionChanged="level_changed" Margin="0,0,14,0"/>
   <Button Content="Columns..." Click="choose_columns" Padding="12,4" Margin="0,0,6,0" ToolTip="Choose which parameters are shown"/><Button Content="Refresh Model" Click="refresh_clicked" Padding="12,4" ToolTip="Re-read Spaces/Rooms from the active project and view"/>
  </WrapPanel>
  <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Clear" Click="clear_clicked" Padding="12,4" Margin="6,0,0,0"/><TextBox x:Name="txtSearch" Height="30" ToolTip="Space-separated words; every word must appear in a visible column" VerticalContentAlignment="Center" FontSize="14" TextChanged="search_changed"/></DockPanel>
 </StackPanel>
 <StackPanel DockPanel.Dock="Bottom"><DockPanel Margin="0,8,0,0"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Select in Revit" Click="select_clicked" Padding="14,5" Margin="0,0,6,0"/><Button Content="Show / Zoom" Click="show_clicked" Padding="14,5" Margin="0,0,6,0"/><Button Content="Close" Click="close_clicked" Padding="14,5"/></StackPanel><StackPanel><TextBlock x:Name="lblCount" FontWeight="SemiBold"/><TextBlock x:Name="lblStatus" Foreground="#555555" TextWrapping="Wrap"/></StackPanel></DockPanel></StackPanel>
 <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserSortColumns="True" CanUserReorderColumns="True" CanUserResizeColumns="True" MouseDoubleClick="row_double_clicked" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
</DockPanel></Window>