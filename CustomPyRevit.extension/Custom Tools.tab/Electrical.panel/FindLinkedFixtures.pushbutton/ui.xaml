<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Linked Fixtures - Stage 2.3" Height="870" Width="1520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="False">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
      <Button Name="btnReloadSpaces" Content="Reload Spaces" Width="120" Margin="0,0,8,0"/>
      <Button Name="btnSaveSettings" Content="Save Settings" Width="110" Margin="0,0,8,0"/>
      <Button Name="btnResetSettings" Content="Reset Settings" Width="110" Margin="0,0,8,0"/>
      <Button Name="btnFilterFamilies" Content="Filter Families..." Width="120" Margin="0,0,8,0"/>
      <TextBlock Name="txtFamilyCount" VerticalAlignment="Center" Foreground="#666" Margin="0,0,16,0" Text=""/>
      <Button Name="btnClose" Content="Close" Width="80"/>
      <TextBlock Name="txtStatus" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#444" Text="Ready."/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="10"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <GroupBox Grid.Column="0" Header="Spaces">
        <Grid Margin="6">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <CheckBox Name="cbActiveView" Grid.Row="0" Margin="0,0,0,8" Content="Active View Spaces Only" IsChecked="True"/>
          <TextBox Name="tbSpaceSearch" Grid.Row="1" Margin="0,0,0,6" ToolTip="Filter spaces"/>
          <ListBox Name="lbSpaces" Grid.Row="2" SelectionMode="Single"/>
        </Grid>
      </GroupBox>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="Scan Settings" Margin="0,0,0,4">
          <Grid Margin="6">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="260"/>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="120"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Linked Model:" VerticalAlignment="Center"/>
            <ComboBox Name="cmbLinkInstance" Grid.Row="0" Grid.Column="1" Margin="3"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Scan tol. mm:" VerticalAlignment="Center"/>
            <TextBox Name="tbScanTolerance" Grid.Row="0" Grid.Column="3" Text="300" Margin="3"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Wall search mm:" VerticalAlignment="Center"/>
            <TextBox Name="tbWallSearchDistance" Grid.Row="0" Grid.Column="5" Text="600" Margin="3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Level filter:" VerticalAlignment="Center"/>
            <ComboBox Name="cmbLevelMode" Grid.Row="1" Grid.Column="1" Margin="3">
              <ComboBoxItem Content="Same Level Name" IsSelected="True"/>
              <ComboBoxItem Content="Ignore Level"/>
            </ComboBox>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Default h. mm:" VerticalAlignment="Center"/>
            <TextBox Name="tbDefaultHeight" Grid.Row="1" Grid.Column="3" Text="300" Margin="3"/>
            <CheckBox Name="cbIgnoreDuplicates" Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="2" Content="Ignore duplicates" Margin="3" IsChecked="True"/>
            <CheckBox Name="cbVerboseDiag" Grid.Row="1" Grid.Column="6" Content="Verbose" Margin="3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Name filters:" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal">
              <TextBlock Text="Inc:" VerticalAlignment="Center" Margin="3,0,3,0"/>
              <TextBox Name="tbIncludeKeywords" Width="300" Margin="3"/>
              <TextBlock Text="Exc:" VerticalAlignment="Center" Margin="8,0,3,0"/>
              <TextBox Name="tbExcludeKeywords" Width="300" Margin="3"/>
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="After place:" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="6" Orientation="Horizontal">
              <CheckBox Name="cbAutoSelectZoom" Content="Auto-select + zoom" Margin="3" IsChecked="True"/>
              <CheckBox Name="cbTagPlaced" Content="Tag placed" Margin="10,3,3,3" IsChecked="True"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Categories" Margin="0,0,0,4">
          <WrapPanel Margin="6">
            <CheckBox Name="catElectricalFixtures" Content="Electrical Fixtures" Margin="4" IsChecked="True"/>
            <CheckBox Name="catDataDevices" Content="Data Devices" Margin="4" IsChecked="True"/>
            <CheckBox Name="catCommunicationDevices" Content="Comms Devices" Margin="4" IsChecked="True"/>
            <CheckBox Name="catLightingFixtures" Content="Lighting Fixtures" Margin="4"/>
            <CheckBox Name="catLightingDevices" Content="Lighting Devices" Margin="4"/>
            <CheckBox Name="catFireAlarmDevices" Content="Fire Alarm" Margin="4"/>
            <CheckBox Name="catSecurityDevices" Content="Security" Margin="4"/>
            <CheckBox Name="catElectricalEquipment" Content="Elec Equipment" Margin="4"/>
            <CheckBox Name="catGenericModel" Content="Generic Model" Margin="4"/>
            <CheckBox Name="catSpecialityEquipment" Content="Speciality Equip" Margin="4"/>
          </WrapPanel>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Mapping Rules (first match wins)" Margin="0,0,0,4">
          <Grid Margin="4">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="150"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,3">
              <TextBlock Text="Keywords" Width="260" FontWeight="Bold" Margin="0,0,4,0"/>
              <TextBlock Text="Target Family / Type" Width="280" FontWeight="Bold" Margin="0,0,4,0"/>
              <TextBlock Text="Height" Width="65" FontWeight="Bold" Margin="0,0,4,0"/>
              <TextBlock Text="Mode" Width="105" FontWeight="Bold" Margin="0,0,4,0"/>
              <TextBlock Text="Ref Plane" Width="170" FontWeight="Bold"/>
            </StackPanel>
            <Border Grid.Row="1" BorderBrush="#CCC" BorderThickness="1">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Name="spRules" Margin="2"/>
              </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4,0,0">
              <Button Name="btnAddRule" Content="+ Add Rule" Width="90" Margin="0,0,6,0"/>
              <Button Name="btnApplyRules" Content="Apply Rules" Width="100" Margin="0,0,6,0"/>
              <TextBlock Text="Auto-applied on scan." VerticalAlignment="Center" Foreground="#888" FontStyle="Italic"/>
            </StackPanel>
          </Grid>
        </GroupBox>

        <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,0,0,4">
          <Button Name="btnScan" Content="Scan Space" Width="120" Margin="0,0,6,0"/>
          <Button Name="btnClearResults" Content="Clear" Width="70" Margin="0,0,6,0"/>
          <Button Name="btnCheckAll" Content="All" Width="50" Margin="0,0,3,0"/>
          <Button Name="btnUncheckAll" Content="None" Width="50" Margin="0,0,10,0"/>
          <TextBlock Name="txtSummary" VerticalAlignment="Center" Foreground="#444" Text="No scan yet."/>
        </DockPanel>

        <Border Grid.Row="4" BorderBrush="#CCC" BorderThickness="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel Name="spResults" Margin="4">
              <TextBlock Text="Select a space and linked model, then scan." Foreground="Gray" FontStyle="Italic" Margin="4"/>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="5" LastChildFill="False" Margin="0,6,0,0">
          <Button Name="btnPlaceChecked" Content="Place Checked" Width="120" Margin="0,0,6,0"/>
          <Button Name="btnUndoLast" Content="Undo Last" Width="100" IsEnabled="False" Margin="0,0,6,0"/>
          <Button Name="btnSelectLast" Content="Select Last" Width="100" IsEnabled="False" Margin="0,0,10,0"/>
          <TextBlock Text="Wall=boundary. Ceiling=linked XY. Ceiling(Face)=ref plane." VerticalAlignment="Center" Foreground="#666"/>
        </DockPanel>
      </Grid>
    </Grid>

    <TextBlock Grid.Row="2" Foreground="#888" Margin="2,6,2,0" TextWrapping="Wrap" FontSize="11"
               Text="Stage 2.3: Family filter dialog, tighter UI. Wall/Ceiling/Ceiling(Face) modes."/>
  </Grid>
</Window>