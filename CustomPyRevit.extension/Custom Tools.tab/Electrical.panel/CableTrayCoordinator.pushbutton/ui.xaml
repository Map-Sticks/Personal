<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cable Tray Coordinator" Width="1120" Height="840" MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="0,0,6,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="btnRevert" Content="Revert last route" Click="revert_clicked" IsEnabled="False"
                        ToolTip="Restore original trays and retain selections. Disabled after any other model change."/>
                <Button Content="Show in Revit" Click="show_clicked"
                        ToolTip="Select and zoom to the picked tray(s) and the last created route"/>
                <Button x:Name="btnApply" Content="Apply" Click="apply_clicked" FontWeight="Bold" Padding="22,3"
                        ToolTip="Cut, re-route and join the tray as previewed (one Undo in Revit)"/>
                <Button Content="Close" Click="close_clicked" Margin="0,0,0,4"/>
            </StackPanel>
            <TextBlock x:Name="lblStatus" VerticalAlignment="Center" TextWrapping="Wrap" Text="Ready."/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                <StackPanel>
                    <GroupBox Header="1. What do you want to do?">
                        <StackPanel>
                            <RadioButton x:Name="rbDetour" GroupName="mode" Margin="0,0,0,4" Checked="mode_changed"
                                         Content="Detour: cut one tray and route it around an obstacle"/>
                            <RadioButton x:Name="rbBridge" GroupName="mode" Checked="mode_changed"
                                         Content="Bridge: join two tray ends across a gap"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="2. Select in Revit">
                        <StackPanel>
                            <Button Content="Use current Revit selection" Click="use_selection_clicked" HorizontalAlignment="Left"
                                    ToolTip="Select 1 tray (detour) or 2 trays (bridge) plus the obstacle(s) in Revit, then click"/>
                            <StackPanel x:Name="panelDetour">
                                <Button Content="Pick tray" Click="pick_tray_clicked" HorizontalAlignment="Left"
                                        ToolTip="The straight cable tray segment that clashes"/>
                                <TextBlock x:Name="lblTray" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"/>
                            </StackPanel>
                            <StackPanel x:Name="panelBridge">
                                <Button Content="Pick 2 tray ends" Click="pick_ends_clicked" HorizontalAlignment="Left"
                                        ToolTip="Pick the tray on each side of the gap (cut the gap first with Revit's tools)"/>
                                <TextBlock x:Name="lblEnds" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"/>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="Add obstacle" Click="add_obstacle_clicked"
                                        ToolTip="Pick one or more elements in this model, then Finish"/>
                                <Button Content="Add linked obstacle" Click="add_linked_obstacle_clicked"
                                        ToolTip="Pick elements in a linked model (structure, mechanical...)"/>
                                <Button Content="Clear" Click="clear_obstacles_clicked"/>
                            </WrapPanel>
                            <TextBlock x:Name="lblObstacles" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,6"/>
                            <CheckBox x:Name="chkIndividualObstacles" Content="Avoid obstacles individually (detour)"
                                      Checked="param_changed" Unchecked="param_changed" Margin="0,0,0,6"
                                      ToolTip="Separate detours; nearby obstacles merge to avoid short connecting sections."/>
                            <CheckBox x:Name="chkElevationPreview" Content="Spatial/mixed routes: show elevation instead of plan"
                                      Checked="param_changed" Unchecked="param_changed" Margin="0,0,0,6"/>
                            <StackPanel x:Name="panelCuts">
                                <WrapPanel>
                                    <Button Content="Pick 2 cut points" Click="pick_cuts_clicked"
                                            ToolTip="Pick on the tray where the detour should leave and rejoin it"/>
                                    <Button Content="Clear" Click="clear_cuts_clicked"/>
                                </WrapPanel>
                                <TextBlock x:Name="lblCuts" TextWrapping="Wrap" Foreground="DimGray"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="3. Method (preset)">
                        <StackPanel>
                            <ListBox x:Name="lstPresets" Height="150" SelectionChanged="preset_changed"/>
                            <TextBlock x:Name="lblPresetInfo" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,4"/>
                            <WrapPanel>
                                <Button Content="Save as preset..." Click="save_preset_clicked"
                                        ToolTip="Save the parameters below as your own preset"/>
                                <Button Content="Delete preset" Click="delete_preset_clicked"/>
                            </WrapPanel>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="4. Parameters">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Direction" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="cmbDirection" SelectionChanged="param_changed"
                                      ToolTip="Auto tries over, under, left and right and uses the smallest offset"/>
                            <TextBlock Grid.Row="1" Text="Bend angle" VerticalAlignment="Center"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cmbAngle" SelectionChanged="param_changed"/>
                            <CheckBox Grid.Row="2" Grid.ColumnSpan="2" x:Name="chkAutoOffset" Margin="0,2,0,6"
                                      Content="Calculate offset from the obstacle" Checked="param_changed" Unchecked="param_changed"/>
                            <TextBlock Grid.Row="3" Text="Offset (mm)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="txtOffset" TextChanged="param_changed"
                                     ToolTip="How far the tray centre line moves up, down or sideways"/>
                            <TextBlock Grid.Row="4" Text="Clearance (mm)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="txtClearance" TextChanged="param_changed"
                                     ToolTip="Gap kept between the tray and the obstacle, all round. Remembered between sessions; picking a built-in preset sets its own clearance."/>
                            <TextBlock Grid.Row="5" Text="Offset step (mm)" VerticalAlignment="Center"
                                       ToolTip="Calculated offsets are rounded UP to a multiple of this, e.g. 25: a needed 287 mm becomes 300 mm. Tidy setting-out numbers only, not a tolerance. 0 = no rounding."/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="txtRound" TextChanged="param_changed"
                                     ToolTip="Calculated offsets are rounded UP to a multiple of this, e.g. 25: a needed 287 mm becomes 300 mm. Tidy setting-out numbers only, not a tolerance. 0 = no rounding."/>
                            <TextBlock Grid.Row="6" Text="Min. straight (mm)" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="6" Grid.Column="1" x:Name="txtMinStraight" TextChanged="param_changed"
                                     ToolTip="Shortest straight tray piece allowed between two fittings, after the fittings are placed. The tool measures how much tray each fitting takes up for this tray type and size and adds it automatically, so you do not need to include it. Remembered between sessions."/>
                            <TextBlock Grid.Row="7" Text="Min. bend radius (mm)" VerticalAlignment="Center"
                                       ToolTip="Smallest elbow bend radius the tool may use when the standard elbows do not fit (route fails, loops, needs a bigger offset or pulls a tray end back). Pick 150/300/450/600 or type your own; it should suit the cables' minimum bending radius. 0 = never reduce. Remembered between sessions."/>
                            <ComboBox Grid.Row="7" Grid.Column="1" x:Name="cmbMinRadius" IsEditable="True"
                                      SelectionChanged="param_changed" KeyUp="param_changed"
                                      ToolTip="Smallest elbow bend radius the tool may use when the standard elbows do not fit (route fails, loops, needs a bigger offset or pulls a tray end back). Pick 150/300/450/600 or type your own; it should suit the cables' minimum bending radius. 0 = never reduce. Remembered between sessions."/>
                            <CheckBox Grid.Row="8" Grid.ColumnSpan="2" x:Name="chkShortLegs" Margin="0,4,0,0"
                                      Content="Allow shorter elbow legs (25 mm)" Checked="param_changed" Unchecked="param_changed"
                                      ToolTip="When the standard elbows do not fit, first shorten their straight legs to 25 mm before reducing the bend radius."/>
                            <CheckBox Grid.Row="9" Grid.ColumnSpan="2" x:Name="chkShallowerBends" Margin="0,4,0,0"
                                      Content="Allow shallower bends to keep the clearance" Checked="param_changed" Unchecked="param_changed"
                                      ToolTip="When the chosen bend angle needs more offset than the obstacle does (its bends need room for their straights), try shallower angles (down to 15 degrees) so the tray stays at the Clearance set instead of jumping further away."/>
                            <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="chkKeepIfFittingFails" Margin="0,4,0,0"
                                      Content="Keep route if a fitting can't be placed"
                                      ToolTip="Off: if any bend fails, nothing is changed"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
            <DockPanel Grid.Column="1">
                <TextBlock DockPanel.Dock="Top" x:Name="lblPreviewTitle" Text="Preview" FontWeight="Bold" FontSize="14"
                           Margin="0,0,0,4"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Foreground="DimGray" FontSize="11"
                               Text="Grey = existing tray (dashed = removed part)   Blue = new route   Red = obstacle, dashed = clearance   Orange = cuts"/>
                    <TextBlock x:Name="txtSummary" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas"/>
                    <TextBlock x:Name="lblMessage" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="DarkOrange"
                               FontWeight="SemiBold"/>
                </StackPanel>
                <GroupBox DockPanel.Dock="Bottom" Header="Route options" Margin="0,6,0,0">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <Button x:Name="btnRegenerate" DockPanel.Dock="Left" Content="Regenerate options"
                                    Click="regenerate_clicked" FontWeight="SemiBold" VerticalAlignment="Top"
                                    ToolTip="Re-reads the picked trays and obstacles from the model, plans every direction and bend angle (and grouped/individual obstacles) with your Clearance, Min. straight and Min. bend radius, test-builds the best routes in Revit (always undone) and lists the top 5. Pick one to preview it, then Apply; after Apply, 'Revert last route' and pick another."/>
                            <TextBlock x:Name="lblOptions" TextWrapping="Wrap" Foreground="DimGray" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="lstOptions" Height="104" SelectionChanged="option_selected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                    </DockPanel>
                </GroupBox>
                <Border BorderBrush="LightGray" BorderThickness="1" Background="White">
                    <Canvas x:Name="cnvPreview" ClipToBounds="True" SizeChanged="preview_resized"/>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
