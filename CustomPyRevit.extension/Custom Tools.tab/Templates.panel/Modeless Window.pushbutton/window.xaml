<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modeless Template" Width="340" SizeToContent="Height"
        ShowInTaskbar="False" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="12">
        <TextBlock x:Name="status_text" Margin="0,0,0,8" Text="-"/>
        <TextBlock Text="Comments value:"/>
        <TextBox x:Name="comment_box" Margin="0,4,0,8" Text="Reviewed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Refresh" Width="80" Margin="0,0,6,0" Click="refresh_click"/>
            <Button Content="Apply" Width="80" Margin="0,0,6,0" Click="apply_click"/>
            <Button Content="Close" Width="80" Click="close_click"/>
        </StackPanel>
    </StackPanel>
</Window>
