<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Place Fixtures in Spaces" Height="720" Width="1320" WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="False" Topmost="False">
  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><Button Name="btnReloadSpaces" Content="Reload Spaces" Width="120" Margin="0,0,8,0"/><Button Name="btnClose" Content="Close" Width="80"/><TextBlock Name="txtStatus" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#444" Text="Ready."/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="Spaces (select one)"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><CheckBox Name="cbActiveView" Grid.Row="0" Margin="0,0,0,8" Content="Show Active View Spaces Only" IsChecked="True"/><TextBox Name="tbSpaceSearch" Grid.Row="1" Margin="0,0,0,6" ToolTip="Filter spaces by number/name"/><ListBox Name="lbSpaces" Grid.Row="2" SelectionMode="Single"/></Grid></GroupBox>
      <TabControl Grid.Column="2">
        <TabItem Header="Manual Placement"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><Button Name="btnPickWalls" Content="Pick Walls (for selected Space)" Width="240" Margin="0,0,8,0"/><Button Name="btnClearWalls" Content="Clear Walls (selected Space)" Width="210" Margin="0,0,8,0"/><Separator Width="10"/><Button Name="btnAddTypes" Content="Add Selected Types to Checked Walls" Width="240" Margin="8,0,8,0"/><Button Name="btnPlace" Content="Place Fixtures" Width="120" Margin="0,0,8,0"/><Button Name="btnUndoPlace" Content="Undo Last Place" Width="120" Margin="0,0,8,0" IsEnabled="False"/></DockPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="4*"/></Grid.ColumnDefinitions><GroupBox Grid.Column="0" Header="Selected Space: Walls / Individual Fixture Controls"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="240"/><RowDefinition Height="6"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.Row="0" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" ClipToBounds="True"><Canvas Name="canvasWallMap" ClipToBounds="True" SnapsToDevicePixels="True"/></Border><GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="#EEEEEE"/><TreeView Grid.Row="2" Name="tvConfig"/></Grid></GroupBox><GroupBox Grid.Column="1" Header="Default Settings for Next Added Type"><Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Row="0" Grid.Column="0" Text="Elevation (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" Name="tbElevation" Text="300" Margin="4"/><TextBlock Grid.Row="1" Grid.Column="0" Text="Offset from Host (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Name="tbHostOffset" Text="0" Margin="4"/><TextBlock Grid.Row="2" Grid.Column="0" Text="End Offset (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Name="tbEndOffset" Text="300" Margin="4"/><TextBlock Grid.Row="3" Grid.Column="0" Text="Min Spacing (mm):" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Name="tbMinSpacing" Text="250" Margin="4"/><TextBlock Grid.Row="4" Grid.Column="0" Text="Comments Base:" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Name="tbComments" Text="OUTLET" Margin="4"/><StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4"><TextBlock Text="Default Qty for Add:" VerticalAlignment="Center"/><TextBox Name="tbDefaultQty" Text="1" Width="60" Margin="8,0,0,0"/></StackPanel><GroupBox Grid.Row="7" Grid.ColumnSpan="2" Header="Available Families (Check to Add)"><ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4"><StackPanel Name="spFamilies"/></ScrollViewer></GroupBox></Grid></GroupBox></Grid></Grid></TabItem>
        <TabItem Header="From Linked Model"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="220"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="Linked Model:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Name="cmbLinkInstance" Width="260" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Name="btnScanLink" Content="Scan Selected Space" Width="150" Margin="0,0,8,0"/><Button Name="btnRescanLink" Content="Re-scan" Width="80" Margin="0,0,12,0"/><TextBlock Text="Scan tol. (mm):" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Name="tbLinkScanTolerance" Width="60" Text="300" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock Name="txtLinkStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666" Text="Select a space, choose a linked architectural model, then click Scan."/></DockPanel><DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8"><TextBlock Text="Reference Level:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Name="cmbLevelRefMode" Width="170" VerticalAlignment="Center" Margin="0,0,8,0"><ComboBoxItem Content="Auto (from Space)" IsSelected="True"/><ComboBoxItem Content="Auto (from Active View)"/><ComboBoxItem Content="Manual (pick level)"/></ComboBox><ComboBox Name="cmbManualLevel" Width="280" VerticalAlignment="Center" IsEnabled="False" Margin="0,0,8,0"/><CheckBox Name="cbVerboseDiag" VerticalAlignment="Center" Margin="8,0,8,0" Content="Verbose diagnostics" IsChecked="False"/><TextBlock Name="txtRefLevelInfo" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#666" FontStyle="Italic" Text="Using space level as reference."/></DockPanel><DockPanel Grid.Row="2" LastChildFill="False" Margin="0,0,0,4"><TextBlock Text="Type Mappings (optional defaults only — each fixture can be overridden below)" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel><Border Grid.Row="3" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Name="spLinkMappings" Margin="4"><TextBlock Text="(Scan a space to populate this list)" Foreground="Gray" FontStyle="Italic" Margin="4"/></StackPanel></ScrollViewer></Border><DockPanel Grid.Row="4" Margin="0,8,0,4" LastChildFill="False"><TextBlock Text="Fixtures Found In This Space — individual mapping and height" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Name="txtLinkFixtureCount" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right"><Button Name="btnLinkCheckAll" Content="Check All" Width="80" Margin="0,0,4,0"/><Button Name="btnLinkUncheckAll" Content="Uncheck All" Width="90"/></StackPanel></DockPanel><Border Grid.Row="5" BorderBrush="#CCCCCC" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Name="spLinkFixtures" Margin="4"><TextBlock Text="(Scan a space to see fixtures from the linked model here)" Foreground="Gray" FontStyle="Italic" Margin="4"/></StackPanel></ScrollViewer></Border><DockPanel Grid.Row="6" Margin="0,8,0,0" LastChildFill="False"><Button Name="btnPlaceFromLink" Content="Place Checked from Link" Width="200" Margin="0,0,8,0"/><Button Name="btnUndoPlaceLink" Content="Undo Last Link Placement" Width="180" IsEnabled="False" Margin="0,0,16,0"/><TextBlock Text="Default height (mm):" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold"/><TextBox Name="tbLinkElevation" Width="70" Text="300" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Foreground="#888" VerticalAlignment="Center" FontStyle="Italic" Text="Each fixture row has its own Family, Type, and Height."/></DockPanel></Grid></TabItem>
      </TabControl>
    </Grid>
    <TextBlock Grid.Row="2" Foreground="#666" Margin="2,8,2,0" TextWrapping="Wrap" Text="Manual Placement: Select Space → Pick Walls → Adjust Defaults → Check Families/Types → Add → Place Fixtures. From Linked Model: Select Space → Choose Link → Set scan tolerance → Scan Space → Map each fixture → Place on Nearest Wall."/>
  </Grid>
</Window>