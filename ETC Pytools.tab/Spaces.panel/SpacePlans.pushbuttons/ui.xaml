<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Space Plans" Height="900" Width="1060" WindowStartupLocation="CenterScreen"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="individual" Content="Individual" GroupName="m" IsChecked="True"/><RadioButton x:Name="grouped" Content="One grouped view" GroupName="m" Margin="15,0"/><TextBlock Text="Group name"/><TextBox x:Name="groupname" Width="260" Margin="8,0"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,8"><Button Content="Clear" DockPanel.Dock="Right" Width="60" Click="clear"/><TextBox x:Name="searchbox" TextChanged="search"/></DockPanel><DataGrid x:Name="grid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Use" Binding="{Binding IsSelected}" Width="55"/><DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="160"/><DataGridTextColumn Header="Number" Binding="{Binding Number}" Width="130"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3" Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,10,0"><Button Content="Select all visible" Click="allon"/><Button Content="Select none visible" Click="alloff" Margin="0,4"/><CheckBox x:Name="floor" Content="Floor Plan" IsChecked="True"/><CheckBox x:Name="rcp" Content="RCP" IsChecked="True"/><TextBlock Text="Scale"/><ComboBox x:Name="scale" IsEditable="True"/><TextBlock Text="Buffer mm"/><TextBox x:Name="buffer"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Rotation"/><ComboBox x:Name="rotation"/><TextBlock Text="Custom angle"/><TextBox x:Name="angle"/><TextBlock Text="Crop style"/><ComboBox x:Name="cropstyle"/><TextBlock Text="Floor template"/><ComboBox x:Name="ft"/><TextBlock Text="RCP template"/><ComboBox x:Name="rt"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,10,0"><CheckBox x:Name="makesheet" Content="Create sheet and place views" FontWeight="Bold"/><TextBlock Text="Sheet mode"/><ComboBox x:Name="sheetmode" SelectionChanged="mode_change"/><TextBlock Text="Title block"/><ComboBox x:Name="titleblock"/><TextBlock Text="Sheet prefix"/><TextBox x:Name="prefix"/><TextBlock Text="Starting number"/><TextBox x:Name="start"/><TextBlock Text="Viewport type"/><ComboBox x:Name="vptype"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="Layout strategy" FontWeight="Bold"/><ComboBox x:Name="strategy"/><TextBlock Text="Review canvas"/><ComboBox x:Name="canvas" SelectionChanged="mode_change"/><TextBlock Text="Custom width mm"/><TextBox x:Name="customw"/><TextBlock Text="Custom height mm"/><TextBox x:Name="customh"/><TextBlock Text="Margins mm"/><TextBox x:Name="margin"/><TextBlock Text="View gap mm"/><TextBox x:Name="gap"/><TextBlock Text="Future elevation slot is already included in the layout data structure." TextWrapping="Wrap" Foreground="Gray" Margin="0,6,0,0"/></StackPanel></Grid><StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Width="90" Click="cancel"/><Button Content="Generate" Width="110" Margin="8,0,0,0" IsDefault="True" Click="go"/></StackPanel></Grid></Window>